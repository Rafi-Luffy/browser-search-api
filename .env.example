# Server Configuration
PORT=8000
HOST=0.0.0.0

# Optional API Authentication Key
# If REQUIRE_AUTH=false or empty, all endpoints allow unlimited public/private access
CRW_API_KEY=
REQUIRE_AUTH=false

# Optional Upstream Services (Optional for enhanced multi-engine search)
SEARXNG_URL=
GITHUB_TOKEN=

# Client SDK URL (defaults to http://localhost:8000 for local dev or your Railway URL when deployed)
CRW_API_URL=http://localhost:8000
